<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to hidden files/directories (e.g. .env, .git)
    RewriteRule (^\.|/\.) - [F,L]

    # Block direct access to internal source directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(\/|$) - [F,L]

    # Block direct access to sensitive file extensions
    RewriteRule \.(env|json|lock|xml|yml|yaml|md|log|sh|sql|sqlite|phar|py)$ - [F,L]

    # Rewrite all public traffic to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent directory browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Block access to sensitive files as a fallback
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(composer\.(json|lock)|package(-lock)?\.json|\.env.*|\.git.*|phpunit\.xml|README\.md|artisan)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>